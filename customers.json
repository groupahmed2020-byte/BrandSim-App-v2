    "technical_support": {
      "no_internet_with_signal": {
        "issue": "وجود إشارة شبكة (4G) ولكن لا يوجد اتصال بالإنترنت",
        "diagnosis_and_solutions": [
          "تأكد من تفعيل بيانات الهاتف وإلغاء وضع الطيران.",
          "لشرائح (Aloha) أو (Mobile): أضف نقطة وصول جديدة. الاسم: prime | APN: prime (أو الاسم: aloha | APN: apn.x2one.com).",
          "لشرائح (Hot Mobile): اختر نقطة وصول Hot Mobile من إعدادات الشبكة.",
          "قم بإعادة تشغيل الهاتف بعد حفظ الإعدادات والانتظار من 5 إلى 10 دقائق."
        ]
      },
      "fair_usage_policy_throttling": {
        "issue": "تقييد سرعة الإنترنت والشبكة بطيئة جداً (خاصة شرائح ألوها وموبايل)",
        "diagnosis": "تم الدخول في وضعية 'تقييد سرعة الإنترنت' بسبب الاستهلاك العالي للبيانات (تجاوز الحد اليومي الآمن 4 إلى 5 جيجا).",
        "solution": "للأسف لا يوجد حل برمجي أو من الدعم الفني لإرجاع السرعة. الحل الوحيد هو نقل الرقم لشركة أخرى (رامي ليفي، وي، هوت موبايل) أو الاستمرار بالسرعة البطيئة حتى تتجدد الباقة."
      },
      "no_4g_on_esim_or_code": {
        "issue": "شريحة إلكترونية (eSIM) أو كود متصلة بالشبكة لكن لا يظهر 4G أو الإنترنت معطل",
        "solution": "توجيه الزبون فوراً لتفعيل خيار 'التجوال الدولي' (Data Roaming) من إعدادات شبكة الجوال."
      },
      "sim_not_supported_x_mark": {
        "issue": "ظهور علامة X على الشبكة رغم تفعيل الشريحة بنجاح من الدعم الفني",
        "solution": "يحدث هذا بسبب عدم توافق الشريحة الحديثة مع الهاتف القديم (أو العكس)، يُرجى تجربة الشريحة في جهاز آخر."
      },
      "refresh_html_error": {
        "issue": "ظهور رسالة 'الرقم غير مسجل' في صفحة التحديث الآلي",
        "solution": "غالباً ما يكون النظام أو الموقع قيد التطوير أو التحديث، أو أن الرقم قيد التفعيل حالياً في السيرفر. يُرجى الانتظار والمحاولة لاحقاً."
      },
      "system_downtime_rami_levy": {
        "issue": "تأخر تفعيل شرائح رامي ليفي (Rami Levy) أو تعليق التفعيل",
        "solution": "غالباً ما يعلق نظام رامي ليفي أيام السبت (Shabbat) بسبب الإجازات في الشركة الأم. يجب إبلاغ الزبون بالانتظار وأن الخلل عام وليس من الوكيل."
      }
    },
    "agent_guidelines_and_rules": {
      "new_agent_requirements": "يُشترط دفع مسبق بقيمة 150 شيكل لفتح لوحة الشحن (وكالة جديدة).",
      "sim_physical_validation": "لفحص الشريحة البلاستيكية والتأكد أنها غير مستخدمة (جديدة): يجب أن تكون النحاسة الخاصة بها تلمع وخالية من أي خدوش أو خطوط احتكاك تدل على إدخالها في هاتف مسبقاً.",
      "anti_spam_policy": "يُمنع منعاً باتاً استخدام الأرقام (الشرائح) لإرسال رسائل وهمية أو احتيالية (Spam/Phishing) بأسماء بنوك أو محافظ إلكترونية. في حال اكتشاف ذلك، سيتم حظر حساب الوكيل (اليوزر) فوراً واحتساب غرامة 1 شيكل لكل رسالة زائدة.",
      "esim_sales_rule": "قبل بيع الشريحة الإلكترونية (eSIM)، يجب سؤال الزبون عن نوع هاتفه والتأكد أنه يدعم التقنية (مثل أجهزة الآيفون الحديثة، سامسونج ألترا).",
      "testing_sims": "الشركات لا توفر شرائح أو أكواد تجريبية مجانية. أي تجربة أو تبديل للشريحة قد يكلف الوكيل 10 شيكل، لذلك يجب التأكد من التغطية قبل البيع.",
      "customer_service_tone": "تجنب إلقاء اللوم على الزبون. في حال وجود عطل من المصدر (مثل تأخر التفعيل)، اشرح أن الخلل عام وأن الدعم التقني يتابع الأمر لضمان عدم خسارة تقييم الزبون."
    },
    "pricing_rules_and_companies_analysis": {
      "hot_mobile": {
        "arabic_name": "هوت موبايل",
        "features": "إنترنت قوي جداً ومستقر، تغطية جيدة في معظم المناطق.",
        "pricing_context": "تجديد الباقة لـ 3 شهور بـ 120 شيكل، بيع الشريحة الجديدة 3 شهور بـ 180 شيكل."
      },
      "pelephone": {
        "arabic_name": "بيليفون",
        "features": "تغطية ممتازة جداً وأبراج قوية (خاصة في المناطق الشمالية والحدودية مثل زيكيم).",
        "notes": "يُفضل بيعها كباقات شهرية، لأن الشركة الأم تقوم أحياناً بسحب عروض الـ 3 شهور فجأة مما يسبب حرجاً للوكلاء مع الزبائن."
      },
      "rami_levy": {
        "arabic_name": "رامي ليفي",
        "features": "أسعار ممتازة للوكلاء وتجديد سلس لـ 3 شهور بشكل متتالي. يعمل على أبراج بيليفون.",
        "notes": "نظامهم التقني قد يتعطل ويكون بطيئاً في الاستجابة والتفعيل، خصوصاً في عطلة نهاية الأسبوع."
      },
      "wecom": {
        "arabic_name": "ويكوم",
        "features": "مطلوبة بشدة وعليها سحب قوي في مناطق الجنوب.",
        "notes": "أسعار تجديدها لـ 3 شهور مستقرة وتعتبر رخيصة نسبياً للوكيل."
      },
      "aloha_and_mobile": {
        "arabic_name": "ألوها وموبايل",
        "features": "شرائح اقتصادية تعمل على أبراج (هوت موبايل وبيليفون). سعر الشريحة الفارغة حوالي 50-55 شيكل.",
        "notes": "تخضع لسياسة استخدام عادل صارمة (سقف استهلاك آمن 4 جيجا يومياً)، تجاوزها يؤدي لتقييد السرعة بشكل دائم."
      },
      "partner": {
        "arabic_name": "بارتنر",
        "features": "شبكة ممتازة، ولكن يُنصح بالتعامل معها عبر مزودي خدمة محددين (مثل ليان) لتجنب الأسعار المرتفعة جداً في أنظمة أخرى (مثل سكاي)."
      }
    },
    "service_providers_comparison": {
      "Layan": "الشركة الأفضل حالياً باعتراف الجميع (سرعة رد، دعم تقني ممتاز، أسعار وعروض مستقرة).",
      "Quick_Line": "الفتى المدلل لشركة سيلكوم، قدرة قوية على اتخاذ قرارات من الشركات الأم، ممتازة في توفير عروض غير موجودة لدى غيرها.",
      "Sky": "ممتازة جداً في خطوط بيليفون وتفعيلاتها.",
      "Aloha_Direct": "أسعارها منافسة جداً لكن الدعم الفني الخاص بها يُعتبر ضعيفاً."
    }
